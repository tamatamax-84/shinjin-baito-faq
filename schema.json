{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["store_id", "store_name", "business_type", "store_rules", "question_form_url"],
  "properties": {
    "store_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$"},
    "store_name": {"type": "string", "minLength": 1, "maxLength": 100},
    "business_type": {"type": "string", "minLength": 1, "maxLength": 50},
    "store_rules": {
      "type": "object", "additionalProperties": false,
      "required": ["appearance", "opening_tasks", "absence_rule", "break_rule", "meal_rule", "closing_tasks"],
      "properties": {
        "appearance": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 200}, "maxItems": 30, "uniqueItems": true},
        "opening_tasks": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 200}, "maxItems": 30, "uniqueItems": true},
        "absence_rule": {"anyOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["method", "note"], "properties": {"method": {"type": "string", "minLength": 1, "maxLength": 100}, "note": {"type": "string", "maxLength": 200}}}]},
        "break_rule": {"anyOf": [{"type": "null"}, {"type": "string", "minLength": 1, "maxLength": 200}]},
        "meal_rule": {"anyOf": [{"type": "null"}, {"type": "string", "minLength": 1, "maxLength": 200}]},
        "closing_tasks": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 200}, "maxItems": 30, "uniqueItems": true}
      }
    },
    "question_form_url": {"type": "string", "pattern": "^https://[^\\s]+$", "maxLength": 2000}
  }
}
